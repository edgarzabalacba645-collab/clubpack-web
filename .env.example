# Copiá este archivo a .env y completá con tus datos reales.
# .env NUNCA se sube a git — pero ojo: estas variables SÍ viajan al navegador
# (eso es lo que significa el prefijo VITE_). Por eso acá va SOLO la anon key
# de Supabase, nunca la service_role key ni las claves de R2.

# --- Supabase (Project Settings > API) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Backend propio (FastAPI) ---
# URL donde corre el backend de ClubPack (transcodificación, BPM, fingerprint, ZIP).
# En desarrollo local suele ser http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
